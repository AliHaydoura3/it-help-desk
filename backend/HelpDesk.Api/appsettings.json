{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 587,
    "FromEmail": "alihaydoura3@gmail.com",
    "FromName": "IT Help Desk",
    "EnableSsl": true,
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "NotificationDelivery": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaximumAttempts": 3
  },
  "Attachments": {
    "StorageRootPath": "App_Data/attachments",
    "MaximumFileSizeBytes": 10485760,
    "MaximumFilesPerTicket": 25,
    "AllowedExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".pdf",
      ".txt",
      ".log",
      ".csv",
      ".zip",
      ".docx",
      ".xlsx"
    ]
  },
  "Reporting": {
    "DefaultPeriodDays": 30,
    "AtRiskThresholdPercentage": 80,
    "PdfRegularFontPath": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "PdfBoldFontPath": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "SlaHours": {
      "Low": 72,
      "Medium": 48,
      "High": 24,
      "Critical": 4
    }
  }
}
